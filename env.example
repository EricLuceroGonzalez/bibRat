# Copia como .env (solo la primera vez):  cp -n .env.example .env
LOG_LEVEL=INFO

# Email de contacto: Crossref (polite pool) y PubMed (obligatorio en E-utilities)
CONTACT_EMAIL=tu@email.com

# Scopus: https://dev.elsevier.com → "I want an API key".
# Funciona solo desde la red de tu institución (campus o VPN) o con insttoken.
SCOPUS_API_KEY=
SCOPUS_INSTTOKEN=
# COMPLETE trae abstracts y todos los autores; si no está autorizada se usa STANDARD
SCOPUS_VIEW=COMPLETE

# PubMed (opcional): cuenta NCBI → Account settings → API Key Management (10 req/s)
NCBI_API_KEY=

# Límites
MAX_RESULTS_PER_SOURCE=1000
# Crossref no admite booleanos: cuántos resultados revisar para filtrarlos localmente
CROSSREF_MAX_SCAN=2000
